digraph snakemake_dag {
    graph[bgcolor=white, margin=0];
    node[shape=box, style=rounded, fontname=sans,                 fontsize=10, penwidth=2];
    edge[penwidth=2, color=grey];
	0[label = "all", color = "0.00 0.6 0.85", style="rounded"];
	1[label = "split json files by chromosome", color = "0.53 0.6 0.85", style="rounded"];
	2[label = "combine json files", color = "0.13 0.6 0.85", style="rounded"];
	3[label = "convert gam files to json", color = "0.49 0.6 0.85", style="rounded"];
	4[label = "filter bad mappings", color = "0.36 0.6 0.85", style="rounded"];
	5[label = "log stats", color = "0.62 0.6 0.85", style="rounded"];
	6[label = "calculate unique read counts", color = "0.58 0.6 0.85", style="rounded"];
	7[label = "estimate fragment length", color = "0.31 0.6 0.85", style="rounded"];
	8[label = "run peak calling until p-values are computed", color = "0.04 0.6 0.85", style="rounded"];
	9[label = "run callpeaks from p-values", color = "0.09 0.6 0.85", style="rounded"];
	10[label = "merge peaks into single fasta", color = "0.27 0.6 0.85", style="rounded"];
	11[label = "flatten peaks to linear", color = "0.40 0.6 0.85", style="rounded"];
	12[label = "find missing peaks", color = "0.44 0.6 0.85", style="rounded"];
	8 -> 0
	9 -> 0
	5 -> 0
	10 -> 0
	1 -> 0
	11 -> 0
	2 -> 1
	3 -> 2
	4 -> 3
	7 -> 5
	6 -> 5
	2 -> 6
	1 -> 7
